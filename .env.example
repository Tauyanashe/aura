# ============================================================
# AURA Environment Configuration
# ============================================================

# Supabase Project Credentials (from Project Settings -> API)
# When deploying to production on Render, set these in Render Dashboard:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Storage Mode:
# 'mock'     -> Local browser persistent mock storage (instant testing)
# 'drive'    -> Authenticated Google Drive streaming via Supabase Edge Functions
VITE_STORAGE_MODE=mock

# Node.js Port (optional, defaults to 3000 or process.env.PORT on Render)
PORT=3000
